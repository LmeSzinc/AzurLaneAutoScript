{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alas",
  "version": "1.0.0",
  "identifier": "com.alas.autoscript",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Alas",
        "width": 1280,
        "height": 880,
        "decorations": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
